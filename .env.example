# --- Server (Node/Express) ---
# Railway sets PORT automatically; local default is 8080
PORT=8080
# Set to "development" ONLY on your own machine. With no WhatsApp provider
# configured, sendOtp then returns the code in its response (devCode) so you
# can log in locally. Never set it to "development" on a real deployment.
# NODE_ENV=production

# Websites allowed to call this API from a browser (comma-separated, no
# trailing slash). Unset = any origin.
# ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:3001

# --- Shared admin login (POST /createAdmin) ---
# The login created/reset by "Create / Reset Admin Login". There is no default
# password: the admin types one in the setup form (12+ characters), or you can
# set ADMIN_PASSWORD here and leave the form's password field empty.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@folkvizag.app
# ADMIN_NAME=Site Administrator
# ADMIN_PASSWORD=
# Firebase UID of the site owner's own account. It may create/reset the admin
# login and is auto-promoted to admin. Must match isRootAdminUid() in the
# client's firestore.rules.
# ROOT_ADMIN_UID=
# Recovery code typed into the bootstrap form when no admin can sign in.
# Must be at least 12 characters, otherwise it is ignored. Remove it again
# once you're back in.
# ADMIN_SETUP_CODE=

# --- Firebase Admin ---
# Preferred: SERVICE_ACCOUNT_KEY as inline JSON (from the serviceAccountKey.json file)
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to a file path, or rely on ADC
SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/serviceAccountKey.json

# --- Razorpay ---
# Get from dashboard.razorpay.com -> Settings -> API Keys
# Use TEST keys during development: key id starts with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Webhook secret = "Secret" shown when you create/edit the webhook in the Razorpay dashboard.
# Add a webhook for the event: payment.captured (and payment.failed) with URL:
#   https://<your-backend>/razorpayWebhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Flaxxa WAPI (WhatsApp OTP login) ---
# Token from your WAPI workspace (https://wapi.flaxxa.com -> settings).
# IMPORTANT: the token is sent INSIDE the JSON body, not as a Bearer header.
# Server-side only; never expose this to the browser. Keeps phone auth on the
# Firebase free tier by sending OTPs via WhatsApp instead of Firebase's paid
# Sign-In-With-Phone.
# WAPI_TOKEN is the canonical name; FLAXXA_API_KEY is accepted as a fallback.
WAPI_TOKEN=your_wapi_token
# Approved OTP template name. Authentication templates take the code as {{1}}.
# WAPI_OTP_TEMPLATE_NAME=otp
# Template language code (default: en).
# WAPI_TEMPLATE_LANG=en
# Override only if not using the default host. Endpoint is:
#   POST https://wapi.flaxxa.com/api/v1/sendtemplatemessage
# WAPI_BASE=https://wapi.flaxxa.com/api/v1/sendtemplatemessage

# --- Gupshup WhatsApp ---
# Register the sender number + app name in the Gupshup WhatsApp Business console first
GUPSHUP_API_KEY=your_gupshup_api_key
# Business WhatsApp number in E.164 without plus (e.g. 919876543210)
GUPSHUP_SOURCE=919876543210
# The App Name registered in Gupshup (used as src.name)
GUPSHUP_APP_NAME=your_gupshup_app_name
# Template IDs (approved in the WhatsApp Manager / Gupshup template catalog)
GUPSHUP_TEMPLATE_ACCOMMODATION_ID=accommodation_status_updated
# Optional additional templates for event/seva broadcasts
# GUPSHUP_TEMPLATE_EVENT_ID=new_event_notification
# GUPSHUP_TEMPLATE_SEVA_ID=new_seva_notification
# Database. With DATABASE_URL set, the server uses Postgres (on Railway:
# ${{Postgres.DATABASE_URL}}). On its first start it locks Firestore for
# browsers and copies every collection over; Firebase Auth still does sign-in.
# Leave it unset (or DATA_BACKEND=firestore) to keep using Firestore.
DATABASE_URL=
# DATA_BACKEND=firestore

# ---------------------------------------------------------------------------
# Cloudflare R2 — trip images (covers, galleries, per-location photos)
# ---------------------------------------------------------------------------
# The browser uploads straight to R2 using a short-lived presigned URL that
# this server signs, so image bytes never pass through the API. Only
# admin/folks_head can request one.
#
# Where each value comes from in the Cloudflare dashboard:
#   R2_ACCOUNT_ID         R2 > Overview — the Account ID in the right sidebar
#   R2_ACCESS_KEY_ID      R2 > Manage R2 API Tokens > Create API token
#   R2_SECRET_ACCESS_KEY  shown once when that token is created
#   R2_BUCKET             the bucket name you created, e.g. folkvizag
#   R2_PUBLIC_BASE_URL    the bucket's public URL, either the r2.dev one from
#                         Settings > Public development URL, or a custom
#                         domain (e.g. https://cdn.harekrishnavizag.org)
#
# The API token needs Object Read & Write on this bucket only.
#
# IMPORTANT — the bucket also needs a CORS rule, or the browser PUT is blocked.
# In R2 > your bucket > Settings > CORS policy:
#   [{ "AllowedOrigins": ["https://your-site.vercel.app", "http://localhost:5173"],
#      "AllowedMethods": ["PUT", "GET"],
#      "AllowedHeaders": ["content-type"],
#      "MaxAgeSeconds": 3600 }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
