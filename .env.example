# --- Server (Node/Express) ---
# Railway sets PORT automatically; local default is 8080
PORT=8080

# --- Firebase Admin ---
# Preferred: SERVICE_ACCOUNT_KEY as inline JSON (from the serviceAccountKey.json file)
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to a file path, or rely on ADC
SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --- Razorpay ---
# Get from dashboard.razorpay.com -> Settings -> API Keys
# Use TEST keys during development: key id starts with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Webhook secret = "Secret" shown when you create/edit the webhook in the Razorpay dashboard.
# Add a webhook for the event: payment.captured (and payment.failed) with URL:
#   https://<your-backend>/razorpayWebhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Gupshup WhatsApp ---
# Register the sender number + app name in the Gupshup WhatsApp Business console first
GUPSHUP_API_KEY=your_gupshup_api_key
# Business WhatsApp number in E.164 without plus (e.g. 919876543210)
GUPSHUP_SOURCE=919876543210
# The App Name registered in Gupshup (used as src.name)
GUPSHUP_APP_NAME=your_gupshup_app_name
# Template IDs (approved in the WhatsApp Manager / Gupshup template catalog)
GUPSHUP_TEMPLATE_ACCOMMODATION_ID=accommodation_status_updated
# Optional additional templates for event/seva broadcasts
# GUPSHUP_TEMPLATE_EVENT_ID=new_event_notification
# GUPSHUP_TEMPLATE_SEVA_ID=new_seva_notification